# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=razorpay_vulcan_ledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# App's async engine (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/razorpay_vulcan_ledger

# LangGraph's PostgresSaver checkpointer (Phase 4) -- psycopg3, not asyncpg
CHECKPOINTER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/razorpay_vulcan_ledger

# LLM provider (Phase 4)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Razorpay -- real webhook/API integration, not just synthetic demo data
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
