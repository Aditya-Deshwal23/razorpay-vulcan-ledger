                    text(
                        "SELECT recon_state, human_decision FROM t_reconciliation_ledger "
                        "WHERE settlement_id = :s"
                    ),
                    {"s": settlement_id},
                )
            ).one()
        assert row.recon_state == "PENDING_HITL_REVIEW"
        assert row.human_decision is None
    finally:
        await _cleanup(run_id)


