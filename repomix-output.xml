.ledger-layout { display: grid; grid-template-columns: minmax(0, 1fr); transition: grid-template-columns 180ms ease; }.ledger-layout.ledger-detail-open { grid-template-columns: minmax(610px, 1fr) minmax(340px, .53fr); }.ledger-table-panel { min-width: 0; overflow: hidden; }.ledger-summary { display: flex; justify-content: space-between; padding: 12px 14px; color: #ded6c9; }.ledger-summary small { color: var(--ash); }.ledger-table-wrap { border: 0; border-radius: 0; }.ledger-table { min-width: 820px; }.ledger-table tr { cursor: pointer; }.ledger-table tbody tr:hover, .ledger-row-selected { background: #2d2924; }.ledger-row-selected { box-shadow: inset 2px 0 0 var(--ember); }.ledger-table td:first-child strong { display: block; color: #e5d7c9; font: 500 11px "IBM Plex Mono", monospace; }.pagination { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 13px 14px; color: var(--ash); font-size: 12px; }.pagination .secondary-button { min-height: 31px; font-size: 12px; }.settlement-drawer { min-width: 0; padding: 23px; border-radius: 0; border-top: 0; border-right: 0; border-bottom: 0; background: #262521; }.drawer-close { position: absolute; top: 14px; right: 14px; }.drawer-title { display: grid; justify-items: start; gap: 8px; padding-right: 28px; }.drawer-title h2 { overflow-wrap: anywhere; font-size: 24px; }.drawer-columns { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 21px; }.drawer-columns dd { font-size: 12px; }.narration-section { margin-top: 20px; }.drawer-fingerprint { margin: 20px 0 8px; padding-top: 16px; border-top: 1px solid #45443e; }.drawer-fingerprint .eyebrow { margin-bottom: 4px; }.drawer-fingerprint .hash-fingerprint { max-width: 100%; }.table-empty { min-height: 470px; }

.audit-page { max-width: 1660px; }.audit-explainer { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 17px; padding: 14px 16px; color: #cfc5b7; }.audit-explainer svg { flex: 0 0 auto; color: #d18e72; }.audit-explainer p { max-width: 910px; margin: 0; }.audit-explainer strong { color: var(--parchment); }
.priority-card { border-color: rgba(201,104,82,.48); }.priority-card h2 { max-width: 470px; }.priority-card p { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; min-height: 26px; }.priority-card code { color: #d5b6a4; font-size: 11px; }.live-exposure-card { border-color: #45453f; }.exposure-number { margin: 17px 0 3px; }.exposure-number .money { font: 500 35px/1 "Fraunces", serif; letter-spacing: -.03em; }.live-exposure-card > p:not(.eyebrow) { max-width: 400px; margin: 0; color: var(--ash); }.exposure-detail { display: flex; align-items: baseline; gap: 7px; margin: 17px 0 2px; color: #c9c0b3; font-size: 12px; }.exposure-detail strong { color: #e4a28d; font: 500 19px "IBM Plex Mono", monospace; }
.queue-item-main strong { font-family: "IBM Plex Sans", sans-serif; }.queue-item-main code { display: block; overflow: hidden; margin-top: 3px; color: #bfb2a4; font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }.queue-item-main small { margin-top: 2px; color: #998d80; font-size: 9px; }.detail-settlement-id { display: block; margin-top: 7px; color: #c7b6a5; font-size: 11px; }.reason-callout { align-items: flex-start; }.reason-callout svg { flex: 0 0 auto; margin-top: 2px; }.reason-callout small { display: block; max-width: 620px; margin-top: 3px; color: #c4b2a5; font-size: 11px; }
.evidence-boundary { margin: 0 0 25px; padding: 15px; border: 1px solid #45433d; border-radius: 7px; background: #21211e; }.boundary-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 12px; }.boundary-heading .eyebrow { margin: 0; }.boundary-heading span { color: var(--ash); font-size: 11px; }.evidence-boundary ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 1px; overflow: hidden; border-radius: 5px; background: #474640; list-style: none; }.evidence-boundary li { display: flex; gap: 8px; min-width: 0; padding: 10px; background: #252420; }.evidence-boundary li svg { flex: 0 0 auto; margin-top: 1px; }.evidence-boundary li div { min-width: 0; }.evidence-boundary strong, .evidence-boundary small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.evidence-boundary strong { color: #e0d8cb; font-size: 11px; }.evidence-boundary small { margin-top: 2px; color: #a79e91; font-size: 10px; }.boundary-source svg, .boundary-audit svg { color: #b8ad9e; }.boundary-pass svg { color: var(--verdigris); }.boundary-alert svg { color: #e08770; }.boundary-ai svg { color: var(--gold); }.boundary-muted svg { color: #827b70; }.boundary-human svg { color: #e0a187; }
.state-preview { display: block; margin-top: 8px; color: #d9b9a6; font: 500 10px "IBM Plex Mono", monospace; }
.audit-state-chain { margin: 0 0 17px; padding: 19px 20px; border: 1px solid #484640; border-radius: var(--radius-panel); background: #20201d; }.audit-state-chain h2 { margin: 0; font: 500 23px "Fraunces", serif; }.audit-state-chain ol { display: grid; gap: 0; margin: 18px 0 0; padding: 0; list-style: none; }.audit-state-chain li { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; align-items: center; gap: 11px; min-height: 57px; padding: 8px 0; }.audit-state-chain li + li { border-top: 1px solid #3b3a36; }.chain-node { display: grid; place-items: center; width: 22px; height: 22px; border: 1px solid #746c62; border-radius: 50%; color: #c7bbab; font: 500 10px "IBM Plex Mono", monospace; }.audit-state-chain li > div { min-width: 0; }.audit-state-chain strong, .audit-state-chain span:not(.chain-node), .audit-state-chain small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.audit-state-chain strong { color: #e3dacd; font-size: 12px; }.audit-state-chain span:not(.chain-node) { margin-top: 1px; color: #bdab9f; font: 400 10px "IBM Plex Mono", monospace; }.audit-state-chain small { margin-top: 2px; color: var(--ash); font-size: 10px; }.audit-state-chain .hash-fingerprint { justify-self: end; }
.settings-page { max-width: 1120px; }.settings-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }.setting-card { display: flex; gap: 13px; padding: 23px; }.setting-card > svg { color: #cb8769; }.setting-card h2 { display: flex; align-items: center; gap: 7px; margin: 0 0 6px; font: 500 22px "Fraunces", serif; }.setting-card h2 svg { color: var(--verdigris); }.setting-card p:not(.eyebrow) { margin: 0; color: var(--ash); }.setting-card code { color: #e2c4ae; font-size: 15px; }.setting-wide { grid-column: 1 / -1; }

