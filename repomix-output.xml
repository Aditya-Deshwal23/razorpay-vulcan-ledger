@media (max-width: 820px) { .page-wrap { padding: 28px 20px 48px; }.topbar { min-height: 57px; padding: 0 20px; }.batch-select-wrap label { display: none; }.overview-verdict, .overview-lower, .settings-grid { grid-template-columns: 1fr; }.needs-you { min-height: 210px; }.page-heading { display: block; margin-bottom: 25px; }.batch-stamp, .integrity-stamp { display: inline-flex; margin-top: 15px; }.metrics-strip { grid-template-columns: 1fr; }.metrics-strip article + article { border-top: 1px solid #393936; border-left: 0; }.review-workspace { display: flex; flex-direction: column; }.review-queue-panel { min-height: 0; border-right: 0; border-bottom: 1px solid #3a3a36; }.queue-items { display: flex; overflow-x: auto; }.queue-item { flex: 0 0 280px; }.evidence-grid { grid-template-columns: 1fr; gap: 20px; }.ledger-tools { grid-template-columns: 1fr 1fr; }.search-field { grid-column: 1 / -1; }.ledger-layout.ledger-detail-open { grid-template-columns: 1fr; }.settlement-drawer { border: 1px solid #3a3a36; border-top: 0; border-radius: 0 0 10px 10px; }.audit-page .page-heading h1 { font-size: 39px; } }
@media (max-width: 600px) { .sidebar { transform: translateX(-100%); width: 232px; padding: 22px 14px 14px; transition: transform 180ms ease; }.sidebar-open { transform: translateX(0); }.wordmark > span:last-child, .nav-link > span { display: initial; }.nav-link { justify-content: flex-start; padding: 10px 11px; }.nav-link-active::before { left: -14px; }.nav-link em { position: static; min-width: 21px; height: 19px; padding: 0 5px; font-size: 11px; }.main-canvas { margin-left: 0; }.mobile-menu.icon-button { display: inline-grid; margin-right: auto; }.scrim { display: block; position: fixed; z-index: 9; inset: 0; border: 0; background: rgba(0,0,0,.52); }.page-heading h1 { font-size: 35px; }.overview-verdict { gap: 12px; }.evidence-braid { grid-template-columns: 1fr; gap: 0; }.braid-join { width: 1px; height: 16px; margin: 0 auto; }.braid-join::before { top: 0; bottom: 0; left: 50%; width: 1px; height: auto; }.braid-join::after { top: auto; right: auto; bottom: 0; left: calc(50% - 3px); transform: rotate(135deg); }.detail-title-row, .decision-panel, .fingerprint-row { display: block; }.confidence { width: 100%; margin-top: 16px; }.decision-actions { min-width: 0; margin-top: 17px; }.fingerprint-row > p { margin-top: 12px; }.variance-comparison { grid-template-columns: 1fr; }.variance-comparison > div + div { border-top: 1px solid #484740; border-left: 0; }.decision-success { align-items: flex-start; flex-wrap: wrap; }.decision-success a { margin-left: 27px; }.ledger-tools { grid-template-columns: 1fr; }.search-field { grid-column: auto; }.pagination { flex-wrap: wrap; }.settings-grid { grid-template-columns: 1fr; }.setting-wide { grid-column: auto; } }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; } }
@media (max-width: 820px) { .evidence-boundary ol { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 600px) { .evidence-boundary ol { grid-template-columns: 1fr; }.boundary-heading { display: block; }.boundary-heading span { display: block; margin-top: 4px; }.audit-state-chain { padding: 16px; }.audit-state-chain li { grid-template-columns: 25px minmax(0, 1fr); }.audit-state-chain .hash-fingerprint { grid-column: 2; justify-self: start; } }

