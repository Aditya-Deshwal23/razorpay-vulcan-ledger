.empty-state, .table-empty { display: grid; place-items: center; padding: 72px 24px; text-align: center; color: var(--ash); }.empty-state h2, .table-empty h2 { margin: 11px 0 4px; color: var(--parchment); font: 500 26px "Fraunces", serif; }.empty-state p, .table-empty p { max-width: 480px; margin: 0; }.empty-state svg, .table-empty svg { color: var(--steel); }
.skeleton { display: grid; gap: 14px; min-height: 180px; padding: 24px; }.skeleton-line, .skeleton-heading span { height: 12px; border-radius: 3px; background: linear-gradient(90deg, #292825 15%, #35332f 45%, #292825 75%); background-size: 200% 100%; animation: shimmer 1.35s ease-in-out infinite; }.skeleton-line:nth-child(2n) { width: 72%; }.skeleton-line:nth-child(3n) { width: 47%; }.skeleton-heading { display: grid; gap: 13px; margin-bottom: 34px; }.skeleton-heading span:first-child { width: 20%; height: 10px; }.skeleton-heading span:last-child { width: 49%; height: 48px; }
