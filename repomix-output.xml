.review-detail { padding: clamp(23px, 3vw, 40px); border: 0; border-radius: 0; background: #262521; }.detail-kicker { display: flex; align-items: center; gap: 10px; color: var(--ash); font-size: 12px; }.detail-title-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 25px; margin-top: 22px; }.detail-title-row h2, .drawer-title h2 { margin: 0; font: 500 28px/1.1 "Fraunces", serif; letter-spacing: -.02em; }.confidence { width: min(205px, 34%); color: var(--ash); font-size: 11px; }.confidence div { display: flex; align-items: center; gap: 8px; margin-top: 5px; }.confidence div::before { display: block; flex: 1; height: 4px; background: #474743; content: ""; }.confidence i { position: absolute; height: 4px; max-width: calc(100% - 38px); background: var(--gold); }.confidence em { color: #e2d6c0; font: 500 11px "IBM Plex Mono", monospace; font-style: normal; }.reason-callout { display: flex; align-items: center; gap: 10px; margin: 22px 0 14px; padding: 11px 12px; border-left: 2px solid var(--rust); background: rgba(104,48,38,.18); }.reason-callout svg { color: var(--rust); }.reason-callout p { margin: 0; color: #bda99e; font-size: 11px; text-transform: uppercase; letter-spacing: .07em; }.reason-callout strong { display: block; margin-top: 1px; color: #eadbd1; font: 500 13px "IBM Plex Mono", monospace; text-transform: capitalize; }
.variance-comparison { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid #484740; border-radius: 7px; overflow: hidden; }.variance-comparison > div { padding: 15px 16px; }.variance-comparison > div + div { border-left: 1px solid #484740; }.variance-comparison p { margin: 0; color: var(--ash); font-size: 10px; text-transform: uppercase; letter-spacing: .07em; }.variance-comparison .money { display: block; margin: 5px 0 3px; font-size: 21px; }.variance-comparison small { color: var(--ash); font-size: 11px; }.variance-aligned { background: rgba(69,121,103,.11); }.variance-aligned small { color: var(--verdigris); }.variance-diverged { background: rgba(117,60,48,.17); }.variance-diverged small { color: #e1927d; }
.evidence-braid { display: grid; grid-template-columns: minmax(0,1fr) 20px minmax(0,1fr) 20px minmax(0,1fr); align-items: stretch; margin: 23px 0; }.braid-node { display: flex; flex-direction: column; gap: 3px; min-height: 104px; padding: 13px; border: 1px solid #474741; border-radius: 6px; background: #22211e; }.braid-node > span { color: var(--ash); font-size: 10px; text-transform: uppercase; letter-spacing: .06em; }.braid-node .money { margin-top: 5px; font-size: 18px; }.braid-node small { margin-top: auto; color: #aaa094; font-size: 10px; }.braid-node-decision { border-color: #865a48; background: #30251f; }.braid-node-decision strong { margin-top: 6px; color: #e3b09b; font: 500 13px "IBM Plex Mono", monospace; }.braid-join { position: relative; min-width: 10px; }.braid-join::before { position: absolute; top: 50%; right: 0; left: 0; height: 1px; background: #8b6759; content: ""; }.braid-join::after { position: absolute; top: calc(50% - 3px); right: 0; width: 6px; height: 6px; border-top: 1px solid #8b6759; border-right: 1px solid #8b6759; content: ""; transform: rotate(45deg); }
.evidence-grid { display: grid; grid-template-columns: .72fr 1.28fr; gap: 28px; padding-top: 2px; }.evidence-grid dl, .drawer-columns dl { margin: 9px 0 0; }.evidence-grid dl div, .drawer-columns dl div { display: flex; justify-content: space-between; gap: 8px; padding: 5px 0; border-bottom: 1px solid #3b3b36; }.evidence-grid dt, .drawer-columns dt { color: var(--ash); font-size: 12px; }.evidence-grid dd, .drawer-columns dd { margin: 0; color: #e1d9cd; text-align: right; }.evidence-grid dd code { font-size: 11px; }.evidence-grid blockquote, .narration-section blockquote { margin: 9px 0 0; padding: 10px 12px; border-left: 2px solid #746a5d; background: #20201d; color: #cdc4b7; font: 400 12px/1.6 "IBM Plex Mono", monospace; white-space: pre-wrap; overflow-wrap: anywhere; }.fingerprint-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #46453e; }.fingerprint-row .eyebrow { margin-bottom: 4px; }.fingerprint-row > p { max-width: 285px; margin: 0; color: var(--ash); font-size: 11px; }
.decision-panel { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-top: 28px; padding-top: 22px; border-top: 1px solid #484740; }.decision-panel h3, .decision-confirm h3 { margin: 0 0 2px; font: 500 21px "Fraunces", serif; }.decision-panel p:not(.eyebrow), .decision-confirm p:not(.eyebrow) { max-width: 490px; margin: 0; color: var(--ash); font-size: 12px; }.decision-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; min-width: 232px; }.decision-button, .secondary-button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 38px; padding: 8px 12px; border: 1px solid #60594f; border-radius: var(--radius-control); background: transparent; color: var(--parchment); font-weight: 500; }.reject-button { border-color: rgba(201,104,82,.8); color: #ebae9c; }.reject-button:hover { background: rgba(201,104,82,.15); }.approve-button { border-color: rgba(107,178,157,.85); color: #b6ded1; }.approve-button:hover { background: rgba(107,178,157,.15); }.secondary-button:hover { border-color: #b49a85; background: #33312d; }.decision-confirm { margin-top: 28px; padding: 20px; border: 1px solid #76604d; border-radius: 8px; background: #2b2823; }.decision-confirm label { display: grid; gap: 5px; margin: 17px 0 12px; color: #bdb3a3; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; }.decision-confirm input, .ledger-tools input, .ledger-tools select { min-height: 37px; border: 1px solid #54524b; border-radius: 5px; background: #201f1c; color: var(--parchment); }.decision-confirm input { width: 100%; padding: 8px 10px; }.confirm-actions { display: flex; justify-content: flex-end; gap: 8px; }.decision-confirm .inline-error { margin: 12px 0; }
.queue-clear-screen { display: grid; justify-items: start; gap: 7px; max-width: 650px; padding: 48px; }.queue-clear-screen svg { color: var(--verdigris); }.queue-clear-screen h1 { margin: 0; font: 500 47px "Fraunces", serif; }.queue-clear-screen p:not(.eyebrow) { margin: 0; color: var(--ash); }

.batch-table-wrap { overflow-x: auto; }.batch-table { min-width: 1000px; }.batch-table th, .batch-table td { padding: 16px; }.batch-id { color: #e9c2ab; font-size: 13px; }.batch-rate { display: block; font: 500 18px "IBM Plex Mono", monospace; }.batch-table .rail-block { min-width: 230px; margin: 0; }.batch-table .rail-legend { display: none; }.needs-link { display: inline-flex; align-items: center; gap: 6px; color: #e59881; }.row-action { display: flex; align-items: center; gap: 5px; color: #dfb79f; }.row-action:hover { color: var(--ember); }

