   BATCH UPLOADER
   ============================================================ */
.uploader-zone { display: flex; align-items: center; gap: 16px; padding: 28px 24px; border: 2px dashed #4a4740; border-radius: var(--radius-panel); background: #1c1b18; color: #c4b8aa; font-size: 13px; cursor: pointer; transition: border-color 140ms, background 140ms; }
.uploader-zone:hover, .uploader-zone:focus-visible { border-color: var(--accent-primary); background: #21201d; outline: none; }
.uploader-dragging { border-color: var(--accent-primary) !important; background: #23221f !important; }
.uploader-uploading { cursor: default; }
.uploader-zone > div strong { display: block; color: #e2d9cc; font-size: 13px; }
.uploader-zone > div small { display: flex; align-items: center; gap: 4px; margin-top: 4px; color: #908480; font-size: 11px; }
.uploader-zone > svg { flex: 0 0 auto; color: #b8ad9e; }
.spinner { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.uploader-result { display: flex; align-items: flex-start; gap: 14px; padding: 20px 22px; border-radius: var(--radius-panel); }
.uploader-success { border: 1px solid #3b6650; background: #1b2820; color: #9dcfb0; }
.uploader-success > svg { flex: 0 0 auto; color: var(--verdigris); margin-top: 2px; }
.uploader-error { border: 1px solid #6b3535; background: #231b1b; color: #e08070; }
.uploader-error > svg { flex: 0 0 auto; color: #e08070; margin-top: 2px; }
.uploader-result-body { flex: 1; min-width: 0; }
.uploader-result-body strong { display: block; color: #e2d9cc; font-size: 13px; }
.uploader-result-body p { margin: 4px 0 0; color: #a89f93; font-size: 12px; }
.uploader-exceptions { color: #e0a060 !important; }
.uploader-warnings { margin: 8px 0 0; padding-left: 16px; color: #a89f93; font-size: 11px; line-height: 1.7; }

/* ============================================================
   TOPBAR ACTION BUTTONS (Export + Upload)
   ============================================================ */
.topbar-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
.topbar-button { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 6px; font-family: "IBM Plex Sans", sans-serif; font-size: 12px; font-weight: 500; cursor: pointer; transition: background 140ms, border-color 140ms, color 140ms; white-space: nowrap; }
.topbar-button-outlined { border: 1px solid #4a4740; background: transparent; color: #c4b8aa; }
.topbar-button-outlined:hover:not(:disabled) { border-color: var(--accent-primary); color: var(--accent-primary); background: rgba(201,156,108,.06); }
.topbar-button-outlined:disabled { opacity: 0.45; cursor: not-allowed; }

/* ============================================================
   RCA BADGE — amber warning tone in Review Queue
   ============================================================ */
.rca-badge { display: flex; align-items: flex-start; gap: 10px; padding: 13px 16px; margin: 0 0 20px; border: 1px solid #7a5c20; border-radius: 7px; background: #241e10; color: #e8c069; }
.rca-badge > svg { flex: 0 0 auto; margin-top: 2px; color: #e8b840; }
.rca-badge .eyebrow { margin: 0 0 4px; font-size: 9px; letter-spacing: .08em; color: #c4963a; }
.rca-badge strong { display: block; color: #f0d898; font-size: 12px; font-weight: 500; line-height: 1.55; font-family: "IBM Plex Sans", sans-serif; }

/* Responsive */
@media (max-width: 820px) { .topbar-actions span { display: none; } .topbar-button { padding: 7px; } }
</file>

