.transition-cell { display: flex; align-items: center; gap: 7px; white-space: nowrap; }.transition-arrow { color: var(--steel); }.mono-link { color: #e3c5b0; font-size: 12px; }.mono-link:hover { color: var(--ember); }
.hash-fingerprint { display: inline-flex; align-items: center; gap: 3px; max-width: 100%; color: #cabaaa; }.hash-fingerprint code { overflow: hidden; font-size: 12px; white-space: nowrap; }.hash-compact code { font-size: 11px; }.icon-button { display: inline-grid; place-items: center; flex: 0 0 auto; width: 29px; height: 29px; padding: 0; border: 0; border-radius: 4px; background: transparent; color: var(--ash); }.icon-button:hover { background: #33312d; color: var(--parchment); }
.money { color: var(--parchment); white-space: nowrap; font-weight: 500; }.money-symbol { margin-right: 2px; color: var(--ash); font-size: .8em; vertical-align: .07em; }
.state-badge { display: inline-flex; align-items: center; gap: 5px; max-width: max-content; padding: 4px 7px; border: 1px solid currentColor; border-radius: 4px; font-size: 11px; font-weight: 500; white-space: nowrap; }.state-matched, .state-approved { color: var(--verdigris); background: rgba(107,178,157,.09); }.state-ai { color: var(--gold); background: rgba(215,165,68,.09); }.state-review, .state-rejected { color: #df8872; background: rgba(201,104,82,.09); }

